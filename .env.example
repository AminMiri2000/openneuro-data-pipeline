# Copy to `.env` (git-ignored) and fill in to receive alert emails locally.
# Both the CLI and Dagster read this file. In GitHub Actions, set the same
# names as repository secrets instead.

# Gmail address that sends the alerts.
ALERT_SMTP_USER=you@gmail.com
# A Gmail *app password* (Google Account > Security > 2-Step Verification >
# App passwords), not your normal password. 16 letters, spaces optional.
ALERT_SMTP_PASSWORD=
# Who receives alerts; comma-separated. Defaults to ALERT_SMTP_USER.
ALERT_EMAIL_TO=you@gmail.com

# Optional: name used in alert subjects, and the Dagster UI address for links.
# ALERT_SOURCE_NAME=Local pipeline
# DAGSTER_UI_URL=http://localhost:3000
